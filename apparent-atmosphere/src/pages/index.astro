---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
</head>
<body>
    <Header />
    <main>
        <h1>Aparna's Portfolio</h1>
        <p>
            Welcome to my personal portfolio where I share my CTF writeups and showcase my coding projects.
			I am a passionate cybersecurity enthusiast and a dedicated programmer. I love solving complex problems, participating in Capture The Flag (CTF) competitions, and developing innovative applications.
        </p>
		<p>
		    My journey in tech started with a curiosity for how systems work, and now I focus on security research, AI-driven applications, and full-stack development. Through this blog, I share my experiences, writeups, and projects that reflect my learning and growth in the field.
		</p>
        <section class="portfolio">
            <h2>My Current Projects</h2>
            <ul>
                <li>MovieMatch </li>
                <li>AI Fake News Detector</li>
                <li>Forest Fire Prediction System </li>
            </ul>
        </section>
        <section class="ctf-writeups">
            <h2>Current CTF Writeups</h2>
            <ul>
                <li>Snyk CTF</li>
                <li>NSA Codebreaker Challenge</li>
                <li>PicoCTF</li>
            </ul>
        </section>
    </main>
    <Footer />
</body>
</html>
